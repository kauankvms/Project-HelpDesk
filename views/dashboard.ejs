<!-- CSS específico do Dashboard -->
<link rel="stylesheet" href="/css/dashboard.css" />

<% function formatarData(data) { if (!data) return "-"; const d = new
Date(data); const dia = String(d.getDate()).padStart(2, '0'); const mes =
String(d.getMonth() + 1).padStart(2, '0'); const ano = d.getFullYear(); const
hora = String(d.getHours()).padStart(2, '0'); const min =
String(d.getMinutes()).padStart(2, '0'); return `${dia}/${mes}/${ano}
${hora}:${min}`; } const total = kpis.total || 0; const pctAbertos = total > 0 ?
Math.round((kpis.abertos / total) * 100) : 0; const pctAndamento = total > 0 ?
Math.round((kpis.emAndamento / total) * 100) : 0; const pctAguardando = total >
0 ? Math.round((kpis.aguardando / total) * 100) : 0; const pctResolvidos = total
> 0 ? Math.round((kpis.resolvidos / total) * 100) : 0; %>

<!-- Saudação e informações de data/hora dinâmicas -->
<div class="saudacao">
  <div>
    <h1>Olá, Kauan Vitor!</h1>
    <p>Aqui está o resumo do que está acontecendo no seu HelpDesk.</p>
  </div>
  <div class="data-hora">
    <span><%= dataExtenso %></span>
    <span><%= dataHoraExtenso %></span>
  </div>
</div>

<!-- Indicadores resumidos dos chamados (KPIs) -->
<div class="cards-resumo">
  <article class="card-resumo">
    <div class="card-icone">
      <svg
        viewBox="0 0 24 24"
        class="icon-card"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
        <path d="M14 2v6h6" />
      </svg>
    </div>
    <span class="card-titulo">Total de Chamados</span>
    <strong class="card-valor"><%= kpis.total %></strong>
    <span class="card-variacao"> Registrados no sistema </span>
  </article>

  <article class="card-resumo">
    <div class="card-icone">
      <svg
        viewBox="0 0 24 24"
        class="icon-card"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"
        />
      </svg>
    </div>
    <span class="card-titulo">Abertos</span>
    <strong class="card-valor"><%= kpis.abertos %></strong>
    <span class="card-variacao positiva"> Aguardando triagem </span>
  </article>

  <article class="card-resumo">
    <div class="card-icone">
      <svg
        viewBox="0 0 24 24"
        class="icon-card"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10" />
        <path d="M12 6v6l4 2" />
      </svg>
    </div>
    <span class="card-titulo">Em andamento</span>
    <strong class="card-valor"><%= kpis.emAndamento %></strong>
    <span class="card-variacao"> Em atendimento técnico </span>
  </article>

  <article class="card-resumo">
    <div class="card-icone">
      <svg
        viewBox="0 0 24 24"
        class="icon-card"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10" />
        <path d="M9 12l2 2 4-4" />
      </svg>
    </div>
    <span class="card-titulo">Resolvidos</span>
    <strong class="card-valor"><%= kpis.resolvidos %></strong>
    <span class="card-variacao positiva"> Solucionados com sucesso </span>
  </article>

  <article class="card-resumo">
    <div class="card-icone">
      <svg
        viewBox="0 0 24 24"
        class="icon-card"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
    </div>
    <span class="card-titulo">Aguardando</span>
    <strong class="card-valor"><%= kpis.aguardando %></strong>
    <span class="card-variacao"> Em espera de terceiros </span>
  </article>
</div>

<!-- Widgets detalhados -->
<div class="painel-widgets">
  <!-- Chamados por Status -->
  <section class="widget widget-status">
    <h3>Chamados por Status</h3>
    <div class="grafico-rosca"></div>
    <ul class="legenda">
      <li>
        <span class="ponto cor-abertos"></span>
        Abertos
        <span class="valor"><%= kpis.abertos %> (<%= pctAbertos %>%)</span>
      </li>
      <li>
        <span class="ponto cor-andamento"></span>
        Em Andamento
        <span class="valor"
          ><%= kpis.emAndamento %>
          (<%= pctAndamento %>%)</span
        >
      </li>
      <li>
        <span class="ponto cor-aguardando"></span>
        Aguardando
        <span class="valor"
          ><%= kpis.aguardando %>
          (<%= pctAguardando %>%)</span
        >
      </li>
      <li>
        <span class="ponto cor-resolvidos"></span>
        Resolvidos
        <span class="valor"
          ><%= kpis.resolvidos %>
          (<%= pctResolvidos %>%)</span
        >
      </li>
    </ul>
  </section>

  <!-- Chamados por Categoria -->
  <section class="widget widget-categoria">
    <h3>Chamados por Categoria</h3>
    <ul class="lista-barras">
      <% if (categorias && categorias.length > 0) { %> <%
      categorias.forEach(function(cat) { const qtd = cat._count ?
      cat._count.chamados : 0; const pctCat = total > 0 ? Math.round((qtd /
      total) * 100) : 0; %>
      <li>
        <span class="nome-categoria"><%= cat.nome %></span>
        <div class="barra">
          <div
            class="barra-preenchida cor-suporte"
            data-largura="<%= pctCat > 0 ? pctCat : 5 %>"
          ></div>
        </div>
        <span class="valor"><%= qtd %> (<%= pctCat %>%)</span>
      </li>
      <% }); %>
      <% } else { %>
      <li style="color: var(--cor-texto-mutado)">
        Nenhuma categoria cadastrada.
      </li>
      <% } %>
    </ul>
  </section>

  <!-- Atalhos Rápidos -->
  <section class="widget widget-atalhos">
    <h3>Atalhos Rápidos</h3>
    <ul class="lista-atalhos">
      <li>
        <a href="/novo-chamado" class="item-atalho">
          <svg
            viewBox="0 0 24 24"
            class="icon-atalho"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="M12 5v14" />
          </svg>
          Abrir Novo Chamado
        </a>
      </li>
      <li>
        <a href="/chamados" class="item-atalho">
          <svg
            viewBox="0 0 24 24"
            class="icon-atalho"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
            <path d="M14 2v6h6" />
          </svg>
          Todos os Chamados
        </a>
      </li>
      <li>
        <a href="/base-conhecimento" class="item-atalho">
          <svg
            viewBox="0 0 24 24"
            class="icon-atalho"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          Base de Conhecimento
        </a>
      </li>
      <li>
        <a href="/relatorios" class="item-atalho">
          <svg
            viewBox="0 0 24 24"
            class="icon-atalho"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"
            />
            <path d="M14 2v5a1 1 0 0 0 1 1h5" />
          </svg>
          Relatórios
        </a>
      </li>
    </ul>
  </section>

  <!-- Chamados Recentes -->
  <section class="widget widget-tabela">
    <h3>Chamados Recentes</h3>
    <div class="tabela-scroll">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Solicitante</th>
            <th>Fila</th>
            <th>Status</th>
            <th>Prioridade</th>
            <th>Atualizado em</th>
          </tr>
        </thead>
        <tbody>
          <% if (chamadosRecentes && chamadosRecentes.length > 0) { %>
          <% chamadosRecentes.forEach(function(c) { %>
          <tr>
            <td><a href="/chamado/<%= c.id %>">#<%= c.numero %></a></td>
            <td><%= c.titulo %></td>
            <td><%= c.solicitante ? c.solicitante.nome : 'Não informado' %></td>
            <td><%= c.fila ? c.fila.nome : 'Sem fila' %></td>
            <td>
              <% if (c.status === 'EM_ANDAMENTO') { %>
              <span class="badge status-andamento">Em Andamento</span>
              <% } else if (c.status === 'AGUARDANDO') { %>
              <span class="badge status-aguardando">Aguardando</span>
              <% } else if (c.status === 'RESOLVIDO') { %>
              <span class="badge status-resolvido">Resolvido</span>
              <% } else if (c.status === 'FECHADO') { %>
              <span class="badge status-fechado">Fechado</span>
              <% } else { %>
              <span class="badge status-aberto">Aberto</span>
              <% } %>
            </td>
            <td>
              <% if (c.prioridade === 'BAIXA') { %>
              <span class="prioridade prioridade-baixa">Baixa</span>
              <% } else if (c.prioridade === 'ALTA') { %>
              <span class="prioridade prioridade-alta">Alta</span>
              <% } else if (c.prioridade === 'CRITICA') { %>
              <span class="prioridade prioridade-critica">Crítica</span>
              <% } else { %>
              <span class="prioridade prioridade-media">Média</span>
              <% } %>
            </td>
            <td><%= formatarData(c.atualizadoEm) %></td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr>
            <td
              colspan="7"
              style="
                text-align: center;
                padding: 1.5rem;
                color: var(--cor-texto-mutado);
              "
            >
              Nenhum chamado recente.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <a href="/chamados" class="ver-todos">Ver todos os chamados &rarr;</a>
  </section>
</div>

<script>
  document
    .querySelectorAll(".barra-preenchida[data-largura]")
    .forEach(function (el) {
      el.style.width = el.getAttribute("data-largura") + "%";
    });
</script>
