<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %> - Help Desk</title>
    <!-- Como estão dentro de public/, os caminhos começam com / -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/componentes.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/ico" href="/imagens/favicon.ico" />
  </head>
  <body>
    <!-- TOPBAR ESTILO ITSM -->
    <header class="topbar">
      <div class="topbar-esquerda">
        <div class="marca">
          <img
            src="/imagens/HelpDesk Logo Branco.png"
            alt="Logo HelpDesk"
            class="logo-topbar"
          />
          <span>HelpDesk</span>
        </div>

        <div class="separador-topbar"></div>

        <!-- Breadcrumbs / Caminho da Tela Atual -->
        <nav class="breadcrumbs" aria-label="Caminho da tela">
          <a href="/dashboard">Início</a>
          <% if (typeof caminho !== 'undefined') { %>
          <% caminho.forEach((item, index) => { %>
          <span class="divisor-crumb">/</span>
          <% if (index === caminho.length - 1) { %>
          <span class="crumb-atual"><%= item %></span>
          <% } else { %>
          <span><%= item %></span>
          <% } %>
          <% }); %>
          <% } %>
        </nav>
      </div>

      <!-- Direita: Busca Global + Novo Chamado + Perfil -->
      <div class="topbar-direita">
        <div class="busca-global-topbar">
          <svg
            viewBox="0 0 24 24"
            class="icon-busca-topbar"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="text"
            placeholder="Busca global (ID, chamado, artigo)..."
            aria-label="Busca global (ID, chamado, artigo)..."
            autocomplete="off"
          />
        </div>

        <button
          type="button"
          class="btn-novo-chamado"
          onclick="window.location.href = '/novo-chamado'"
        >
          <svg
            viewBox="0 0 24 24"
            class="icon-btn"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          <span>Novo Chamado</span>
        </button>

        <div class="perfil-usuario">
          <% let nomeExibicao = 'Kauan Vitor'; let cargoExibicao =
          'Administrador'; if (typeof usuarioLogado !== 'undefined' &&
          usuarioLogado && usuarioLogado.nome) { nomeExibicao =
          usuarioLogado.nome; if (usuarioLogado.perfil === 'TECNICO') {
          cargoExibicao = 'Técnico'; } else if (usuarioLogado.perfil ===
          'SOLICITANTE') { cargoExibicao = 'Solicitante'; } else { cargoExibicao
          = 'Administrador'; } } const partes =
          nomeExibicao.trim().split(/\s+/); const iniciaisTop = partes.length
          === 1 ? partes[0].substring(0, 2).toUpperCase() : (partes[0][0] +
          partes[partes.length - 1][0]).toUpperCase(); %>
          <div class="avatar"><%= iniciaisTop %></div>
          <div class="dados-usuario">
            <span class="nome"><%= nomeExibicao %></span>
            <span class="cargo"><%= cargoExibicao %></span>
          </div>
          <a
            href="/logout"
            title="Sair do sistema"
            aria-label="Sair"
            style="
              margin-left: 0.5rem;
              color: var(--cor-cinza-texto-secundario);
              display: flex;
              align-items: center;
              text-decoration: none;
            "
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- SIDEBAR ITSM -->
    <aside class="sidebar" id="app-sidebar">
      <nav class="menu-lateral">
        <a
          href="/dashboard"
          class="<%= paginaAtiva === 'dashboard' ? 'ativo' : '' %>"
          title="Visão Geral"
        >
          <svg
            viewBox="0 0 24 24"
            class="icon-lateral"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
            <path d="M9 22V12h6v10" />
          </svg>
          <span>Visão Geral</span>
        </a>

        <a
          href="/chamados"
          class="<%= paginaAtiva === 'chamados' ? 'ativo' : '' %>"
          title="Chamados"
        >
          <svg
            viewBox="0 0 24 24"
            class="icon-lateral"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>Chamados</span>
        </a>

        <!-- Base de Conhecimento com SVG do Livro Aberto -->
        <a
          href="/base-conhecimento"
          class="<%= paginaAtiva === 'base-conhecimento' ? 'ativo' : '' %>"
          title="Base de Conhecimento"
        >
          <svg
            viewBox="0 0 24 24"
            class="icon-lateral"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
          </svg>
          <span>Base de Conhecimento</span>
        </a>

        <a
          href="/relatorios"
          class="<%= paginaAtiva === 'relatorios' ? 'ativo' : '' %>"
          title="Relatórios"
        >
          <svg
            viewBox="0 0 24 24"
            class="icon-lateral"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="20" x2="18" y2="10" />
            <line x1="12" y1="20" x2="12" y2="4" />
            <line x1="6" y1="20" x2="6" y2="14" />
          </svg>
          <span>Relatórios</span>
        </a>

        <a
          href="/administracao"
          class="<%= paginaAtiva === 'administracao' ? 'ativo' : '' %>"
          title="Administração"
        >
          <svg
            viewBox="0 0 24 24"
            class="icon-lateral"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="3" />
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
            />
          </svg>
          <span>Administração</span>
        </a>
      </nav>

      <!-- Divisor e Filas -->
      <section class="filas">
        <!-- Menu Suspenso: Filas de Atendimento -->
        <div class="item-menu-suspenso" id="item-filas">
          <button
            type="button"
            class="link-menu-suspenso"
            id="btn-submenu-filas"
            title="Filas de Atendimento"
          >
            <svg
              viewBox="0 0 24 24"
              class="icon-lateral"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="12 2 2 7 12 12 22 7 12 2" />
              <polyline points="2 17 12 22 22 17" />
              <polyline points="2 12 12 17 22 12" />
            </svg>
            <span class="texto-menu">Filas</span>
            <svg
              viewBox="0 0 24 24"
              class="seta-submenu"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <!-- Submenu estilo Gaveta Integrada -->
          <div class="submenu-filas" id="submenu-filas">
            <a href="/chamados?fila=suporte-tecnico" class="sublink-fila">
              <span>Suporte Técnico</span>
            </a>
            <a href="/chamados?fila=infraestrutura" class="sublink-fila">
              <span>Infraestrutura</span>
            </a>
            <a href="/chamados?fila=recursos-humanos" class="sublink-fila">
              <span>Recursos Humanos</span>
            </a>
            <a href="/chamados?fila=financeiro" class="sublink-fila">
              <span>Financeiro</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Rodapé com Versão acima e Botão de Recolher abaixo -->
      <div class="rodape-sidebar">
        <div class="box-versao">
          <span class="versao">v1.0.0</span>
        </div>
        <button
          type="button"
          id="btn-toggle-sidebar"
          class="btn-recolher-sidebar"
          title="Recolher / Expandir Menu"
          aria-label="Recolher menu lateral"
        >
          <svg
            viewBox="0 0 24 24"
            class="icon-recolher"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6" />
          </svg>
          <span class="texto-recolher">Recolher Menu</span>
        </button>
      </div>
    </aside>

    <!-- O CONTEÚDO DE CADA PÁGINA SERÁ INJETADO AQUI AUTOMATICAMENTE -->
    <main class="content"><%- body %></main>

    <!-- BOTÃO FLUTUANTE DE SUPORTE ONLINE (CANTO INFERIOR) -->
    <button
      type="button"
      class="btn-suporte-flutuante"
      title="Suporte Online HelpDesk"
      onclick="alert('Chat de suporte em tempo real em desenvolvimento')"
    >
      <svg
        viewBox="0 0 24 24"
        class="icon-suporte-flutuante"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
        />
      </svg>
      <span>Suporte</span>
    </button>
    <script src="/js/layout.js"></script>
  </body>
</html>
