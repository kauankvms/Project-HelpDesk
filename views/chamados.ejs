  <div class="paginacao">
    <div class="paginacao-esquerda">
      <span class="paginacao-info" id="paginacao-info">
        Exibindo <strong>1-6</strong> de <strong>6</strong> chamados
      </span>

      <div class="itens-por-pagina">
        <label for="select-itens-por-pagina">Exibir:</label>
        <select id="select-itens-por-pagina" class="select-paginacao">
          <option value="5">5</option>
          <option value="10" selected>10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
        <span>por página</span>
      </div>
    </div>

    <div class="paginacao-controles">
      <button
        type="button"
        class="btn-pag"
        id="btn-anterior"
        disabled
        aria-label="Página anterior"
      >
        &laquo; Anterior
      </button>
      <div class="paginacao-numeros" id="paginacao-numeros"></div>
      <button
        type="button"
        class="btn-pag"
        id="btn-proximo"
        aria-label="Próxima página"
      >
        Próxima &raquo;
      </button>
    </div>
  </div>
</section>

