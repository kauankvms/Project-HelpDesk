<!-- CSS específico da página de Chamados -->
<link rel="stylesheet" href="/css/chamados.css" />

<div class="cabecalho-pagina">
  <div>
    <h1>Chamados</h1>
    <p class="subtitulo">Acompanhe e gerencie todos os chamados do sistema.</p>
  </div>
</div>

<form class="filtros">
  <div class="filtro">
    <label for="filtro-status">Status:</label>
    <select id="filtro-status" name="status">
      <option value="">Todos</option>
      <option value="aberto">Aberto</option>
      <option value="em-andamento">Em andamento</option>
      <option value="aguardando">Aguardando</option>
      <option value="resolvido">Resolvido</option>
      <option value="fechado">Fechado</option>
    </select>
  </div>
  <div class="filtro">
    <label for="filtro-fila">Fila:</label>
    <select id="filtro-fila" name="fila">
      <option value="">Todas</option>
      <option value="suporte-tecnico">Suporte Técnico</option>
      <option value="infraestrutura">Infraestrutura</option>
      <option value="recursos-humanos">Recursos Humanos</option>
      <option value="financeiro">Financeiro</option>
    </select>
  </div>
  <div class="filtro">
    <label for="filtro-categoria">Categoria:</label>
    <select id="filtro-categoria" name="categoria">
      <option value="">Todas</option>
      <option value="suporte-tecnico">Suporte Técnico</option>
      <option value="infraestrutura">Infraestrutura</option>
      <option value="software">Software</option>
      <option value="acesso-permissoes">Acesso / Permissões</option>
      <option value="outros">Outros</option>
    </select>
  </div>
  <div class="filtro">
    <label for="filtro-prioridade">Prioridade:</label>
    <select id="filtro-prioridade" name="prioridade">
      <option value="">Todas</option>
      <option value="baixa">Baixa</option>
      <option value="media">Média</option>
      <option value="alta">Alta</option>
      <option value="critica">Crítica</option>
    </select>
  </div>
  <div class="filtro">
    <label for="filtro-tecnico">Técnico:</label>
    <select id="filtro-tecnico" name="tecnico">
      <option value="">Todos</option>
      <option value="kauan">Kauan Vitor</option>
      <option value="joao">João</option>
      <option value="maria">Maria</option>
      <option value="pedro">Pedro</option>
    </select>
  </div>
  <input
    type="search"
    name="busca"
    aria-label="Buscar por ID ou título"
    placeholder="Buscar por ID ou título"
  />
  <button type="reset">Limpar Filtros</button>
</form>

<section class="widget">
  <div class="tabela-scroll">
    <table class="tabela-chamados">
      <thead>
        <tr>
          <th>ID</th>
          <th>Título</th>
          <th>Solicitante</th>
          <th>Técnico</th>
          <th>Fila</th>
          <th>Categoria</th>
          <th>Status</th>
          <th>Prioridade</th>
          <th>Atualizado</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof chamados !== 'undefined' && chamados.length > 0) { %>
        <% chamados.forEach(function(c) { %>
        <tr>
          <td><a href="/chamado/<%= c.id %>">#<%= c.numero %></a></td>
          <td><%= c.titulo %></td>
          <td><%= c.solicitante ? c.solicitante.nome : 'Não informado' %></td>
          <td><%= c.tecnico ? c.tecnico.nome : 'Não atribuído' %></td>
          <td><%= c.fila ? c.fila.nome : 'Sem fila' %></td>
          <td><%= c.categoria ? c.categoria.nome : 'Geral' %></td>
          <td>
            <% if (c.status === 'EM_ANDAMENTO') { %>
            <span class="badge status-andamento">Em Andamento</span>
            <% } else if (c.status === 'AGUARDANDO') { %>
            <span class="badge status-aguardando">Aguardando</span>
            <% } else if (c.status === 'RESOLVIDO') { %>
            <span class="badge status-resolvido">Resolvido</span>
            <% } else if (c.status === 'FECHADO') { %>
            <span class="badge status-fechado">Fechado</span>
            <% } else { %>
            <span class="badge status-aberto">Aberto</span>
            <% } %>
          </td>
          <td>
            <% if (c.prioridade === 'BAIXA') { %>
            <span class="prioridade prioridade-baixa">Baixa</span>
            <% } else if (c.prioridade === 'ALTA') { %>
            <span class="prioridade prioridade-alta">Alta</span>
            <% } else if (c.prioridade === 'CRITICA') { %>
            <span class="prioridade prioridade-critica">Crítica</span>
            <% } else { %>
            <span class="prioridade prioridade-media">Média</span>
            <% } %>
          </td>
          <td>
            <% 
                  const d = new Date(c.atualizadoEm);
                  const dia = String(d.getDate()).padStart(2, '0');
                  const mes = String(d.getMonth() + 1).padStart(2, '0');
                  const ano = d.getFullYear();
                  const hora = String(d.getHours()).padStart(2, '0');
                  const min = String(d.getMinutes()).padStart(2, '0');
                %>
            <%= `${dia}/${mes}/${ano} ${hora}:${min}` %>
          </td>
        </tr>
        <% }); %>
        <% } else { %>
        <tr>
          <td
            colspan="9"
            style="
              text-align: center;
              padding: 2rem;
              color: var(--cor-texto-mutado);
            "
          >
            Nenhum chamado encontrado no banco de dados.
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="paginacao">
    <div class="paginacao-esquerda">
      <span class="paginacao-info" id="paginacao-info">
        Exibindo <strong>1-6</strong> de <strong>6</strong> chamados
      </span>

      <div class="itens-por-pagina">
        <label for="select-itens-por-pagina">Exibir:</label>
        <select id="select-itens-por-pagina" class="select-paginacao">
          <option value="5">5</option>
          <option value="10" selected>10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
        <span>por página</span>
      </div>
    </div>

    <div class="paginacao-controles">
      <button
        type="button"
        class="btn-pag"
        id="btn-anterior"
        disabled
        aria-label="Página anterior"
      >
        &laquo; Anterior
      </button>
      <div class="paginacao-numeros" id="paginacao-numeros"></div>
      <button
        type="button"
        class="btn-pag"
        id="btn-proximo"
        aria-label="Próxima página"
      >
        Próxima &raquo;
      </button>
    </div>
  </div>
</section>

<!-- Script de filtros e paginação da tabela -->
<script src="/js/chamados.js"></script>
