<!-- CSS específico da página de Detalhes do Chamado -->
<link rel="stylesheet" href="/css/detalhes-chamado.css" />

<!-- Navegação de Retorno e Título -->
<div class="cabecalho-pagina cabecalho-detalhes">
  <div>
    <div class="migalhas">
      <a href="/chamados">&larr; Voltar para Chamados</a>
    </div>
    <div class="titulo-com-badge">
      <h1>Instalação de software</h1>
      <span class="codigo-chamado">#HD-2567</span>
      <span class="badge status-andamento" id="badge-status-topo"
        >Em Andamento</span
      >
    </div>
    <p class="subtitulo">Aberto em 14/05/2026 às 09:45 por Mariana Souza</p>
  </div>
</div>

<div class="grid-detalhes">
  <!-- COLUNA PRINCIPAL (ESQUERDA) -->
  <div class="coluna-principal">
    <!-- Card com a Descrição Original -->
    <div class="card-detalhes">
      <h3>Descrição do Problema</h3>
      <div class="conteudo-descricao">
        <p>
          Preciso da instalação do pacote Adobe Creative Cloud (especialmente
          Photoshop e Illustrator) para a nova máquina de trabalho do
          departamento de Design. Já possuímos as licenças ativas vinculadas ao
          e-mail institucional.
        </p>
        <p>
          Máquina já configurada na rede e pronta para acesso remoto ou
          presencial.
        </p>
      </div>

      <!-- Anexos Iniciais -->
      <div class="secao-anexos-detalhe">
        <h4>Anexos (1)</h4>
        <div class="lista-anexos-existentes">
          <a href="#" class="item-anexo-existente">
            <svg
              viewBox="0 0 24 24"
              class="icon-anexo"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              />
              <polyline points="14 2 14 8 20 8" />
            </svg>
            <span>comprovante_licenca_adobe.pdf (1.2 MB)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Abas de Atividades: Comentários e Histórico -->
    <div class="card-detalhes card-atividades">
      <div class="abas-navegacao">
        <button type="button" class="btn-aba ativo" data-aba="comentarios">
          Comentários (2)
        </button>
        <button type="button" class="btn-aba" data-aba="historico">
          Histórico de Alterações
        </button>
      </div>

      <!-- CONTEÚDO DA ABA 1: COMENTÁRIOS -->
      <div class="conteudo-aba ativo" id="aba-comentarios">
        <div class="timeline-comentarios" id="timeline-comentarios">
          <!-- Comentário 1 (Técnico / Público) -->
          <div class="comentario-item">
            <div class="comentario-avatar">KV</div>
            <div class="comentario-corpo">
              <div class="comentario-topo">
                <span class="autor">Kauan Vitor (Analista)</span>
                <span class="data">14/05/2026 às 10:15</span>
              </div>
              <div class="comentario-texto">
                Bom dia, Mariana! Já localizei o chamado na fila do Suporte
                Técnico e iniciei o atendimento. Vou solicitar a chave no portal
                e realizo o acesso remoto em instantes.
              </div>
            </div>
          </div>

          <!-- Comentário 2 (Nota Interna - Apenas técnicos) -->
          <div class="comentario-item nota-interna">
            <div class="comentario-avatar">KV</div>
            <div class="comentario-corpo">
              <div class="comentario-topo">
                <span class="autor">Kauan Vitor (Analista)</span>
                <span class="badge-tipo-nota">Nota Interna</span>
                <span class="data">14/05/2026 às 10:20</span>
              </div>
              <div class="comentario-texto">
                Verifiquei que a máquina está no ativo #NOT-042. Chave de
                ativação alocada no pool corporativo de TI.
              </div>
            </div>
          </div>
        </div>

        <!-- Formulário para Adicionar Comentário -->
        <form id="form-novo-comentario" class="form-novo-comentario">
          <div class="seletores-comentario">
            <label class="radio-label">
              <input
                type="radio"
                name="tipo-comentario"
                value="publico"
                checked
              />
              <span>Resposta Pública</span>
            </label>
            <label class="radio-label">
              <input type="radio" name="tipo-comentario" value="interno" />
              <span>Nota Interna (Privada)</span>
            </label>
          </div>
          <textarea
            id="texto-comentario"
            rows="4"
            placeholder="Escreva uma resposta ou nota interna sobre o atendimento..."
            required
          ></textarea>
          <div class="rodape-form-comentario">
            <button type="submit" class="btn-enviar-comentario">
              Enviar Resposta
            </button>
          </div>
        </form>
      </div>

      <!-- CONTEÚDO DA ABA 2: HISTÓRICO DE AUDITORIA -->
      <div class="conteudo-aba" id="aba-historico">
        <ul class="timeline-historico">
          <li class="historico-item">
            <div class="ponto-historico"></div>
            <div class="historico-info">
              <span class="historico-acao"
                ><strong>Kauan Vitor</strong> assumiu o chamado</span
              >
              <span class="historico-data">14/05/2026 10:15</span>
            </div>
          </li>
          <li class="historico-item">
            <div class="ponto-historico"></div>
            <div class="historico-info">
              <span class="historico-acao"
                >Status alterado: de <code>Aberto</code> para
                <code>Em Andamento</code></span
              >
              <span class="historico-data">14/05/2026 10:15</span>
            </div>
          </li>
          <li class="historico-item">
            <div class="ponto-historico"></div>
            <div class="historico-info">
              <span class="historico-acao"
                >Chamado criado por <strong>Mariana Souza</strong></span
              >
              <span class="historico-data">14/05/2026 09:45</span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- COLUNA LATERAL DE INFORMAÇÕES (DIREITA) -->
  <div class="coluna-lateral">
    <!-- Card de Ações Rápidas -->
    <div class="card-detalhes card-acoes-atendimento">
      <h3>Ações do Atendimento</h3>
      <div class="botoes-acoes-chamado">
        <button
          type="button"
          class="btn-acao-status btn-resolver"
          id="btn-resolver"
        >
          ✓ Resolver Chamado
        </button>
        <button
          type="button"
          class="btn-acao-status btn-aguardar"
          id="btn-aguardar"
        >
          Colocar em Espera
        </button>
      </div>
    </div>

    <!-- Card de Informações e Metadados -->
    <div class="card-detalhes">
      <h3>Informações do Chamado</h3>
      <div class="detalhe-item">
        <span class="detalhe-rotulo">Status</span>
        <span class="badge status-andamento" id="badge-status-lateral"
          >Em Andamento</span
        >
      </div>
      <div class="detalhe-item">
        <span class="detalhe-rotulo">Prioridade</span>
        <span class="prioridade prioridade-alta">Alta</span>
      </div>
      <div class="detalhe-item">
        <span class="detalhe-rotulo">Técnico Responsável</span>
        <div class="usuario-linha">
          <div class="mini-avatar">KV</div>
          <span>Kauan Vitor</span>
        </div>
      </div>
      <div class="detalhe-item">
        <span class="detalhe-rotulo">Solicitante</span>
        <div class="usuario-linha">
          <div class="mini-avatar solicitante">MS</div>
          <div>
            <strong>Mariana Souza</strong>
            <small class="subtexto-usuario">mariana.souza@empresa.com</small>
          </div>
        </div>
      </div>
      <div class="detalhe-item">
        <span class="detalhe-rotulo">Fila</span>
        <span>Suporte Técnico</span>
      </div>
      <div class="detalhe-item">
        <span class="detalhe-rotulo">Categoria</span>
        <span>Software</span>
      </div>
      <div class="detalhe-item">
        <span class="detalhe-rotulo">Ativo Relacionado</span>
        <span>Notebook Dell Inspiron #NOT-042</span>
      </div>

      <!-- Card SLA -->
      <div class="box-sla-detalhes">
        <div class="sla-header">
          <span>Prazo SLA</span>
          <span class="sla-badge-tempo">Restam 2h 45min</span>
        </div>
        <div class="barra-sla">
          <div class="barra-preenchimento" style="width: 65%"></div>
        </div>
        <small class="sla-prazo-final">Vencimento: 14/05/2026 às 13:45</small>
      </div>
    </div>
  </div>
</div>

<!-- Script de interatividade dos detalhes (abas, comentários e ações de status) -->
<script src="/js/detalhes-chamado.js"></script>
