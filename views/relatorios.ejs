<!-- CSS específico da página de Relatórios -->
<link rel="stylesheet" href="/css/relatorios.css" />

<!-- Cabeçalho + Filtro de Período -->
<div class="cabecalho-relatorio">
  <div>
    <h1>Relatórios</h1>
    <p class="subtitulo">Métricas e indicadores de desempenho do atendimento</p>
  </div>

  <div class="filtro-periodo">
    <button
      type="button"
      class="btn-periodo <%= periodoAtivo === 'hoje' ? 'ativo' : '' %>"
      data-periodo="hoje"
    >
      Hoje
    </button>
    <button
      type="button"
      class="btn-periodo <%= periodoAtivo === 'semana' ? 'ativo' : '' %>"
      data-periodo="semana"
    >
      Esta Semana
    </button>
    <button
      type="button"
      class="btn-periodo <%= periodoAtivo === 'mes' ? 'ativo' : '' %>"
      data-periodo="mes"
    >
      Este Mês
    </button>
    <div class="separador-periodo"></div>
    <div class="periodo-personalizado">
      <input
        type="date"
        id="data-inicio"
        aria-label="Data inicial"
        value="<%= dataInicio %>"
      />
      <span>até</span>
      <input
        type="date"
        id="data-fim"
        aria-label="Data final"
        value="<%= dataFim %>"
      />
      <button type="button" class="btn-aplicar-periodo" id="btn-aplicar">
        Aplicar
      </button>
    </div>
  </div>
</div>

<!-- KPIs -->
<div class="grid-kpis" id="grid-kpis">
  <div class="card-kpi">
    <div class="kpi-icone kpi-azul">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
        <polyline points="14 2 14 8 20 8" />
      </svg>
    </div>
    <div class="kpi-info">
      <span class="kpi-rotulo">Total de Chamados</span>
      <span class="kpi-valor" id="kpi-total"><%= kpis.total %></span>
    </div>
  </div>

  <div class="card-kpi">
    <div class="kpi-icone kpi-verde">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="10" />
        <path d="M9 12l2 2 4-4" />
      </svg>
    </div>
    <div class="kpi-info">
      <span class="kpi-rotulo">Resolvidos</span>
      <span class="kpi-valor" id="kpi-resolvidos"><%= kpis.resolvidos %></span>
    </div>
  </div>

  <div class="card-kpi">
    <div class="kpi-icone kpi-laranja">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 16 14" />
      </svg>
    </div>
    <div class="kpi-info">
      <span class="kpi-rotulo">Tempo Médio de Resolução</span>
      <span class="kpi-valor" id="kpi-tma"><%= kpis.tma %></span>
    </div>
  </div>

  <div class="card-kpi">
    <div class="kpi-icone kpi-roxo">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
    </div>
    <div class="kpi-info">
      <span class="kpi-rotulo">SLA Cumprido</span>
      <span class="kpi-valor" id="kpi-sla"><%= kpis.sla %></span>
    </div>
  </div>

  <div class="card-kpi">
    <div class="kpi-icone kpi-vermelho">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
        />
        <line x1="12" y1="9" x2="12" y2="13" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
      </svg>
    </div>
    <div class="kpi-info">
      <span class="kpi-rotulo">SLA Violado</span>
      <span class="kpi-valor kpi-valor-critico" id="kpi-violado"
        ><%= kpis.violado %></span
      >
    </div>
  </div>
</div>

<!-- Gráficos -->
<div class="grid-graficos">
  <!-- Gráfico: Chamados por Status (Rosca) -->
  <div class="widget widget-grafico">
    <h3>Chamados por Status</h3>
    <div class="grafico-rosca-relatorio">
      <div class="rosca" data-gradiente="<%= gradienteRosca %>"></div>
      <ul class="legenda-rosca">
        <li>
          <span
            class="ponto"
            style="background-color: var(--cor-status-aberto)"
          ></span>
          <span>Aberto</span>
          <strong><%= statusData.ABERTO %></strong>
        </li>
        <li>
          <span
            class="ponto"
            style="background-color: var(--cor-status-em-andamento)"
          ></span>
          <span>Em Andamento</span>
          <strong><%= statusData.EM_ANDAMENTO %></strong>
        </li>
        <li>
          <span
            class="ponto"
            style="background-color: var(--cor-status-aguardando)"
          ></span>
          <span>Aguardando</span>
          <strong><%= statusData.AGUARDANDO %></strong>
        </li>
        <li>
          <span
            class="ponto"
            style="background-color: var(--cor-status-resolvido)"
          ></span>
          <span>Resolvido</span>
          <strong><%= statusData.RESOLVIDO %></strong>
        </li>
      </ul>
    </div>
  </div>

  <!-- Gráfico: Chamados por Categoria (Barras Horizontais) -->
  <div class="widget widget-grafico">
    <h3>Chamados por Categoria</h3>
    <ul class="grafico-barras-horizontais">
      <% if (categoriasData && categoriasData.length > 0) { %> <%
      categoriasData.forEach((cat) => { %>
      <li>
        <span class="rotulo-barras"><%= cat.nome %></span>
        <div class="trilha-barra">
          <div
            class="barra-fill"
            data-largura="<%= cat.percentual %>"
            data-cor="<%= cat.cor %>"
          ></div>
        </div>
        <span class="valor-barra"><%= cat.total %></span>
      </li>
      <% }); %>
      <% } else { %>
      <li style="padding: 1rem 0; color: var(--cor-cinza-texto-secundario)">
        Nenhuma categoria cadastrada.
      </li>
      <% } %>
    </ul>
  </div>
</div>

<!-- Tabela: Desempenho por Técnico -->
<div class="widget">
  <h3>Desempenho por Técnico</h3>
  <div class="tabela-scroll">
    <table class="tabela-desempenho">
      <thead>
        <tr>
          <th>Técnico</th>
          <th>Atribuídos</th>
          <th>Resolvidos</th>
          <th>Em Aberto</th>
          <th>Tempo Médio</th>
          <th>SLA Cumprido</th>
        </tr>
      </thead>
      <tbody>
        <% if (tecnicosData && tecnicosData.length > 0) { %> <%
        tecnicosData.forEach((tec) => { %>
        <tr>
          <td>
            <div class="tecnico-linha">
              <div class="mini-avatar-rel"><%= tec.iniciais %></div>
              <span><%= tec.nome %></span>
            </div>
          </td>
          <td><%= tec.totalAtribuidos %></td>
          <td><%= tec.totalResolvidos %></td>
          <td><%= tec.totalAberto %></td>
          <td><%= tec.tma %></td>
          <td>
            <div class="sla-inline">
              <div class="barra-fundo">
                <div
                  class="barra-preenchida <%= tec.sla >= 90 ? 'cor-sla' : '' %>"
                  data-sla="<%= tec.sla %>"
                ></div>
              </div>
              <span><%= tec.sla %>%</span>
            </div>
          </td>
        </tr>
        <% }); %>
        <% } else { %>
        <tr>
          <td
            colspan="6"
            style="
              text-align: center;
              color: var(--cor-cinza-texto-secundario);
              padding: 1.5rem;
            "
          >
            Nenhum técnico cadastrado no sistema.
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Script de filtros de período, métricas e renderização dinâmica -->
<script src="/js/relatorios.js"></script>
