</div>

<!-- Modal: Novo Usuário -->
<div class="modal-overlay" id="modal-usuario" hidden>
  <div class="modal-card">
    <div class="modal-cabecalho">
      <h3>Cadastrar Novo Usuário</h3>
      <button type="button" class="btn-fechar-modal" id="btn-fechar-modal">
        &times;
      </button>
    </div>
    <form id="form-novo-usuario">
      <div class="campo-grupo">
        <label for="nome-usuario"
          >Nome Completo <span class="obrigatorio">*</span></label
        >
        <input
          type="text"
          id="nome-usuario"
          required
          placeholder="Ex: Roberto Andrade"
        />
      </div>
      <div class="campo-grupo">
        <label for="email-usuario"
          >E-mail Corporativo <span class="obrigatorio">*</span></label
        >
        <input
          type="email"
          id="email-usuario"
          required
          placeholder="roberto.andrade@empresa.com"
        />
      </div>
      <div class="campo-duplo">
        <div class="campo-grupo">
          <label for="perfil-usuario-select"
            >Perfil <span class="obrigatorio">*</span></label
          >
          <select id="perfil-usuario-select" required>
            <option value="Solicitante">Solicitante</option>
            <option value="Analista">Analista</option>
            <option value="Administrador">Administrador</option>
          </select>
        </div>
        <div class="campo-grupo">
          <label for="depto-usuario">Departamento</label>
          <input type="text" id="depto-usuario" placeholder="Ex: Financeiro" />
        </div>
      </div>
      <div class="modal-rodape">
        <button
          type="button"
          class="btn-cancelar-modal"
          id="btn-cancelar-modal"
        >
          Cancelar
        </button>
        <button type="submit" class="btn-salvar-modal">Salvar Usuário</button>
      </div>
    </form>
  </div>
</div>

<!-- Script do painel de administração (abas, filtros e modal) -->
