  <!-- ABA 2: FILAS DE ATENDIMENTO -->
  <div class="conteudo-aba" id="aba-filas">
    <div class="barra-acoes-admin">
      <p class="descricao-secao-admin">
        Filas definem o direcionamento dos chamados e seus respectivos tempos de
        SLA.
      </p>
      <button
        type="button"
        class="btn-novo-admin"
        onclick="alert('Funcionalidade de cadastro em desenvolvimento')"
      >
        + Nova Fila
      </button>
    </div>
    <div class="tabela-scroll">
      <table class="tabela-admin">
        <thead>
          <tr>
            <th>Fila</th>
            <th>Líder Técnico</th>
            <th>Analistas Vinculados</th>
            <th>SLA Padrão</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Suporte Técnico</strong></td>
            <td>Maria Oliveira</td>
            <td>4 analistas</td>
            <td>8 horas úteis</td>
            <td><span class="badge status-resolvido">Ativa</span></td>
          </tr>
          <tr>
            <td><strong>Infraestrutura</strong></td>
            <td>João Silva</td>
            <td>3 analistas</td>
            <td>4 horas úteis</td>
            <td><span class="badge status-resolvido">Ativa</span></td>
          </tr>
          <tr>
            <td><strong>Recursos Humanos</strong></td>
            <td>Ana Ribeiro</td>
            <td>2 analistas</td>
            <td>24 horas úteis</td>
            <td><span class="badge status-resolvido">Ativa</span></td>
          </tr>
          <tr>
            <td><strong>Financeiro</strong></td>
            <td>Pedro Costa</td>
            <td>2 analistas</td>
            <td>24 horas úteis</td>
            <td><span class="badge status-resolvido">Ativa</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ABA 3: CATEGORIAS -->
  <div class="conteudo-aba" id="aba-categorias">
    <div class="barra-acoes-admin">
      <p class="descricao-secao-admin">
        Associação de categorias aos tipos de problemas e filas padrão.
      </p>
      <button
        type="button"
        class="btn-novo-admin"
        onclick="alert('Funcionalidade de cadastro em desenvolvimento')"
      >
        + Nova Categoria
      </button>
    </div>
    <div class="tabela-scroll">
      <table class="tabela-admin">
        <thead>
          <tr>
            <th>Categoria</th>
            <th>Fila Padrão</th>
            <th>Prioridade Sugerida</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Software</strong></td>
            <td>Suporte Técnico</td>
            <td><span class="prioridade prioridade-media">Média</span></td>
            <td><span class="badge status-resolvido">Ativa</span></td>
          </tr>
          <tr>
            <td><strong>Hardware</strong></td>
            <td>Infraestrutura</td>
            <td><span class="prioridade prioridade-alta">Alta</span></td>
            <td><span class="badge status-resolvido">Ativa</span></td>
          </tr>
          <tr>
            <td><strong>Rede e Internet</strong></td>
            <td>Infraestrutura</td>
            <td><span class="prioridade prioridade-alta">Alta</span></td>
