<!-- CSS específico do Painel de Administração -->
<link rel="stylesheet" href="/css/administracao.css" />

<% 
  function obterIniciais(nome) {
    if (!nome) return "--";
    const partes = nome.trim().split(/\s+/);
    if (partes.length === 1) return partes[0].substring(0, 2).toUpperCase();
    return (partes[0][0] + partes[partes.length - 1][0]).toUpperCase();
  }
%>

<div class="cabecalho-pagina">
  <div>
    <h1>Painel de Administração</h1>
    <p class="subtitulo">
      Gerencie usuários, permissões, filas de atendimento e categorias do
      sistema.
    </p>
  </div>
</div>

<!-- Abas de Navegação Administrativa -->
<div class="widget widget-admin">
  <div class="abas-navegacao">
    <button type="button" class="btn-aba ativo" data-aba="usuarios">
      Usuários (<%= usuarios ? usuarios.length : 0 %>)
    </button>
    <button type="button" class="btn-aba" data-aba="filas">
      Filas de Atendimento (<%= filas ? filas.length : 0 %>)
    </button>
    <button type="button" class="btn-aba" data-aba="categorias">
      Categorias (<%= categorias ? categorias.length : 0 %>)
    </button>
  </div>

  <!-- ABA 1: USUÁRIOS -->
  <div class="conteudo-aba ativo" id="aba-usuarios">
    <div class="barra-acoes-admin">
      <div class="busca-admin">
        <input
          type="text"
          id="busca-usuario"
          placeholder="Buscar por nome ou e-mail..."
          aria-label="Buscar por nome ou e-mail..."
          autocomplete="off"
        />
      </div>
      <div class="filtros-admin-direita">
        <select id="filtro-perfil-admin">
          <option value="">Todos os perfis</option>
          <option value="Administrador">Administrador</option>
          <option value="Técnico">Técnico</option>
          <option value="Solicitante">Solicitante</option>
        </select>
        <button
          type="button"
          class="btn-novo-admin"
          id="btn-abrir-modal-usuario"
        >
          + Novo Usuário
        </button>
      </div>
    </div>

    <div class="tabela-scroll">
      <table class="tabela-admin" id="tabela-usuarios">
        <thead>
          <tr>
            <th>Usuário</th>
            <th>E-mail</th>
            <th>Perfil</th>
            <th>Cargo / Departamento</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (usuarios && usuarios.length > 0) { %>
          <% usuarios.forEach(function(u) { 
                 const perfilNome = u.perfil ? u.perfil.nome : 'SOLICITANTE';
                 let classeBadge = 'perfil-solicitante';
                 let textoPerfil = 'Solicitante';

                 if (perfilNome === 'ADMIN') {
                   classeBadge = 'perfil-admin';
                   textoPerfil = 'Administrador';
                 } else if (perfilNome === 'TECNICO') {
                   classeBadge = 'perfil-analista';
                   textoPerfil = 'Técnico';
                 }
            %>
          <tr>
            <td>
              <div class="usuario-admin-info">
                <div
                  class="mini-avatar <%= perfilNome === 'SOLICITANTE' ? 'solicitante' : '' %>"
                >
                  <%= obterIniciais(u.nome) %>
                </div>
                <strong><%= u.nome %></strong>
              </div>
            </td>
            <td><%= u.email %></td>
            <td>
              <span class="badge-perfil <%= classeBadge %>"
                ><%= textoPerfil %></span
              >
            </td>
            <td><%= u.cargo || 'Não informado' %></td>
            <td>
              <span
                class="status-dot <%= u.ativo ? 'ativo' : 'inativo' %>"
              ></span>
              <%= u.ativo ? 'Ativo' : 'Inativo' %>
            </td>
            <td>
              <button
                type="button"
                class="btn-acao-tabela"
                title="Editar Usuário"
                aria-label="Editar Usuário"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="icon-acao"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                  />
                  <path
                    d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                  />
                </svg>
              </button>
            </td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr>
            <td
              colspan="6"
              style="
                text-align: center;
                padding: 2rem;
                color: var(--cor-texto-mutado);
              "
            >
              Nenhum usuário cadastrado.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ABA 2: FILAS DE ATENDIMENTO -->
  <div class="conteudo-aba" id="aba-filas">
    <div class="barra-acoes-admin">
      <p class="descricao-secao-admin">
        Filas definem o direcionamento dos chamados e as equipes responsáveis
        pelo atendimento.
      </p>
    </div>
    <div class="tabela-scroll">
      <table class="tabela-admin">
        <thead>
          <tr>
            <th>Fila</th>
            <th>Descrição</th>
            <th>Técnicos Vinculados</th>
            <th>Total de Chamados</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (filas && filas.length > 0) { %>
          <% filas.forEach(function(f) { 
                 const qtdTecnicos = f.usuarios ? f.usuarios.length : 0;
                 const qtdChamados = f._count ? f._count.chamados : 0;
            %>
          <tr>
            <td>
              <strong><%= f.nome %></strong>
            </td>
            <td><%= f.descricao || 'Sem descrição' %></td>
            <td>
              <%= qtdTecnicos %>
              <%= qtdTecnicos === 1 ? 'técnico' : 'técnicos' %>
            </td>
            <td>
              <%= qtdChamados %>
              chamados
            </td>
            <td>
              <span
                class="badge <%= f.ativo ? 'status-resolvido' : 'status-fechado' %>"
              >
                <%= f.ativo ? 'Ativa' : 'Inativa' %>
              </span>
            </td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr>
            <td
              colspan="5"
              style="
                text-align: center;
                padding: 2rem;
                color: var(--cor-texto-mutado);
              "
            >
              Nenhuma fila cadastrada.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ABA 3: CATEGORIAS -->
  <div class="conteudo-aba" id="aba-categorias">
    <div class="barra-acoes-admin">
      <p class="descricao-secao-admin">
        Categorias estruturam as solicitações e estabelecem os prazos padrões de
        SLA em horas.
      </p>
    </div>
    <div class="tabela-scroll">
      <table class="tabela-admin">
        <thead>
          <tr>
            <th>Categoria</th>
            <th>Prazo SLA Padrão</th>
            <th>Total de Chamados</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (categorias && categorias.length > 0) { %>
          <% categorias.forEach(function(cat) { 
                 const qtdChamados = cat._count ? cat._count.chamados : 0;
            %>
          <tr>
            <td>
              <strong><%= cat.nome %></strong>
            </td>
            <td>
              <%= cat.slaHoras %>
              horas úteis
            </td>
            <td>
              <%= qtdChamados %>
              chamados
            </td>
            <td>
              <span
                class="badge <%= cat.ativo ? 'status-resolvido' : 'status-fechado' %>"
              >
                <%= cat.ativo ? 'Ativa' : 'Inativa' %>
              </span>
            </td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr>
            <td
              colspan="4"
              style="
                text-align: center;
                padding: 2rem;
                color: var(--cor-texto-mutado);
              "
            >
              Nenhuma categoria cadastrada.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Novo Usuário -->
<div class="modal-overlay" id="modal-usuario" hidden>
  <div class="modal-card">
    <div class="modal-cabecalho">
      <h3>Cadastrar Novo Usuário</h3>
      <button type="button" class="btn-fechar-modal" id="btn-fechar-modal">
        &times;
      </button>
    </div>
    <form id="form-novo-usuario" action="/administracao/usuarios" method="POST">
      <div class="campo-grupo">
        <label for="nome-usuario"
          >Nome Completo <span class="obrigatorio">*</span></label
        >
        <input
          type="text"
          id="nome-usuario"
          name="nome"
          required
          placeholder="Ex: Roberto Andrade"
        />
      </div>
      <div class="campo-grupo">
        <label for="email-usuario"
          >E-mail Corporativo <span class="obrigatorio">*</span></label
        >
        <input
          type="email"
          id="email-usuario"
          name="email"
          required
          placeholder="roberto.andrade@empresa.com"
        />
      </div>
      <div class="campo-duplo">
        <div class="campo-grupo">
          <label for="perfil-usuario-select"
            >Perfil <span class="obrigatorio">*</span></label
          >
          <select id="perfil-usuario-select" name="perfilNome" required>
            <option value="SOLICITANTE">Solicitante</option>
            <option value="TECNICO">Técnico</option>
            <option value="ADMIN">Administrador</option>
          </select>
        </div>
        <div class="campo-grupo">
          <label for="depto-usuario">Cargo / Departamento</label>
          <input
            type="text"
            id="depto-usuario"
            name="cargo"
            placeholder="Ex: Analista Financeiro"
          />
        </div>
      </div>
      <div class="modal-rodape">
        <button
          type="button"
          class="btn-cancelar-modal"
          id="btn-cancelar-modal"
        >
          Cancelar
        </button>
        <button type="submit" class="btn-salvar-modal">Salvar Usuário</button>
      </div>
    </form>
  </div>
</div>

<!-- Script do painel de administração (abas, filtros e modal) -->
<script src="/js/administracao.js"></script>
