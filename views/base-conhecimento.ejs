<!-- CSS específico da Base de Conhecimento -->
<link rel="stylesheet" href="/css/base-conhecimento.css" />

<!-- Cabeçalho com busca em destaque -->
<div class="hero-busca">
  <h1>Base de Conhecimento</h1>
  <p>Encontre soluções, tutoriais e respostas para as dúvidas mais comuns.</p>
  <div class="campo-busca-hero">
    <svg
      viewBox="0 0 24 24"
      class="icon-busca-hero"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input
      type="text"
      id="busca-artigos"
      placeholder="Buscar artigos, tutoriais ou erros..."
      aria-label="Buscar artigos, tutoriais ou erros..."
      autocomplete="off"
    />
  </div>
</div>

<!-- Filtro de Categorias -->
<div class="filtro-categorias">
  <button type="button" class="pill-categoria ativo" data-categoria="todos">
    Todos os artigos
  </button>
  <% if (categorias && categorias.length > 0) { %>
  <% categorias.forEach(function(cat) { 
         const catSlug = cat.nome.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-');
    %>
  <button type="button" class="pill-categoria" data-categoria="<%= catSlug %>">
    <%= cat.nome %>
  </button>
  <% }); %>
  <% } %>
</div>

<!-- Contador de resultados -->
<p class="contador-artigos" id="contador-artigos">
  Exibindo <strong><%= artigos ? artigos.length : 0 %></strong>
  <%= artigos && artigos.length === 1 ? 'artigo' : 'artigos' %>
</p>

<!-- Grid de Cards de Artigos -->
<div class="grid-artigos" id="grid-artigos">
  <% if (artigos && artigos.length > 0) { %>
  <% artigos.forEach(function(art) { 
         const catNome = art.categoria ? art.categoria.nome : 'Geral';
         const catSlug = catNome.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-');
         const d = new Date(art.criadoEm);
         const dia = String(d.getDate()).padStart(2, '0');
         const mes = String(d.getMonth() + 1).padStart(2, '0');
         const ano = d.getFullYear();
         const dataFmt = `${dia}/${mes}/${ano}`;
    %>
  <article
    class="card-artigo"
    data-categoria="<%= catSlug %>"
    data-titulo="<%= art.titulo %>"
  >
    <div class="card-artigo-icone categoria-<%= catSlug %>">
      <% if (catSlug.includes('rede')) { %>
      <!-- Ícone de Wi-Fi / Rede -->
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M5 12.55a11 11 0 0 1 14.08 0" />
        <path d="M1.42 9a16 16 0 0 1 21.16 0" />
        <path d="M8.53 16.11a6 6 0 0 1 6.95 0" />
        <circle cx="12" cy="20" r="1" fill="currentColor" />
      </svg>
      <% } else if (catSlug.includes('hard')) { %>
      <!-- Ícone de Impressora / Hardware -->
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline points="6 9 6 2 18 2 18 9" />
        <path
          d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
        />
        <rect x="6" y="14" width="12" height="8" />
      </svg>
      <% } else if (catSlug.includes('acess')) { %>
      <!-- Ícone de Cadeado / Acessos -->
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <% } else { %>
      <!-- Ícone de Software / Tela -->
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <rect x="2" y="3" width="20" height="14" rx="2" />
        <path d="M8 21h8M12 17v4" />
      </svg>
      <% } %>
    </div>
    <div class="card-artigo-corpo">
      <span class="pill-label categoria-<%= catSlug %>"><%= catNome %></span>
      <h3><%= art.titulo %></h3>
      <p><%= art.conteudo %></p>
    </div>
    <div class="card-artigo-rodape">
      <span class="artigo-autor"
        ><%= art.autor ? art.autor.nome : 'Equipe de TI' %></span
      >
      <span class="artigo-data"><%= dataFmt %></span>
    </div>
  </article>
  <% }); %>
  <% } %>
</div>

<!-- Estado Vazio (exibido quando a busca não encontra nada) -->
<div class="estado-vazio" id="estado-vazio" style="display: none">
  <svg
    viewBox="0 0 24 24"
    class="icon-vazio"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <circle cx="11" cy="11" r="8" />
    <line x1="21" y1="21" x2="16.65" y2="16.65" />
    <line x1="8" y1="11" x2="14" y2="11" />
  </svg>
  <h3>Nenhum artigo encontrado</h3>
  <p>
    Não encontramos resultados para "<span id="termo-buscado"></span>". Tente
    palavras-chave diferentes ou verifique a ortografia.
  </p>
</div>

<!-- Script da Base de Conhecimento (busca e filtros) -->
<script src="/js/base-conhecimento.js"></script>
